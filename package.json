{
  "name": "servispro",
  "version": "1.0.0",
  "private": true,
  "description": "ServisPro — workshop management PWA",
  "scripts": {
    "build": "node build/build.js",
    "build:test": "node build/build-test.js",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "npm run build:test && node tests/run-all.js",
    "test:xss": "npm run build:test && node tests/xss-escaping.test.js",
    "test:sync": "npm run build:test && node tests/job-pos-invoice.test.js",
    "check": "npm run typecheck && npm run build && npm test",
    "deploy": "node build/deploy.js",
    "build:android": "node build/build-android.js"
  },
  "devDependencies": {
    "@bubblewrap/cli": "^1.25.0",
    "playwright": "^1.62.1",
    "typescript": "^7.0.2"
  },
  "overrides": {
    "uuid": "^11.1.1"
  }
}
